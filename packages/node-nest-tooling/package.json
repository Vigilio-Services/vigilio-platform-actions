{
  "name": "@vigilio-services/node-nest-tooling",
  "version": "0.3.2",
  "description": "Versioned Node.js and NestJS project tooling for Vigilio repositories.",
  "type": "module",
  "private": false,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vigilio-Services/vigilio-platform-actions.git",
    "directory": "packages/node-nest-tooling"
  },
  "bin": {
    "vigilio-node": "./dist/bin/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "lint": "biome ci .",
    "prepack": "pnpm build",
    "pretest": "pnpm build",
    "test": "vitest run --pool=threads",
    "test:coverage": "vitest run --coverage --pool=threads",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "24.10.4",
    "@types/pg": "8.18.0",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
