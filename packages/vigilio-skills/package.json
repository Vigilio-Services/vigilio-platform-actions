{
  "name": "@vigilio-services/vigilio-skills",
  "version": "0.8.0",
  "description": "Versioned AI skills with explicit, conflict-safe synchronization.",
  "type": "module",
  "private": false,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vigilio-Services/vigilio-platform-actions.git",
    "directory": "packages/vigilio-skills"
  },
  "bin": {
    "vigilio-skills": "./dist/bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.js"
    },
    "./platform-context": {
      "types": "./dist/platform-context.d.ts",
      "import": "./dist/platform-context.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-assets.ts && tsc -p tsconfig.build.json",
    "lint": "biome ci .",
    "prepack": "pnpm build",
    "test": "node scripts/build-assets.ts && vitest run --pool=threads",
    "test:coverage": "node scripts/build-assets.ts && vitest run --coverage --pool=threads",
    "typecheck": "tsc --noEmit",
    "evals:update-golden": "node -e \"process.env.UPDATE_EVAL_GOLDEN='true'; const cp = require('node:child_process'); const res = cp.spawnSync('pnpm', ['vitest', 'run', 'tests/observability-evals.test.ts'], { stdio: 'inherit', shell: true }); process.exit(res.status ?? 0);\"",
    "check:docs": "node scripts/check-doc-references.mjs",
    "check:registry": "node scripts/build-skills-registry.mjs --check"
  },
  "files": [
    "assets",
    "dist",
    "README.md"
  ],
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "24.10.4",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "volta": {
    "node": "24.x"
  }
}
