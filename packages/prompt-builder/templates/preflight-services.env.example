# Runtime readiness policy for scripts/preflight-env.sh.
# Copy to scripts/preflight-services.env and commit only non-secret settings.
# Secret values stay in the named environment variables; never put URLs with
# credentials, tokens or passwords in this file.

# true = required, false = not adopted, auto = required only when the URL env exists.
PREFLIGHT_REQUIRE_POSTGRES=auto
PREFLIGHT_POSTGRES_URL_ENV=DATABASE_URL
PREFLIGHT_REQUIRE_REDIS=auto
PREFLIGHT_REDIS_URL_ENV=REDIS_URL
PREFLIGHT_REQUIRE_DOCKER=auto
PREFLIGHT_REQUIRE_UI=auto
PREFLIGHT_REQUIRE_TARGET_PROFILES=auto
# Relative to project root or absolute. Must match the queue runner --assets value.
PREFLIGHT_ASSETS_DIR=assets

# Semicolon-separated name=target entries. Names are printed; targets are not.
# PREFLIGHT_REQUIRED_DIRECTORIES=backend=apps/backend;frontend=apps/frontend
# PREFLIGHT_REQUIRED_WRITABLE_DIRECTORIES=runner=.prompt-runner;backend=apps/backend
# PREFLIGHT_REQUIRED_FILES=backend-contract=apps/backend/packages/contracts/package.json
# PREFLIGHT_REQUIRED_TCP=postgres=127.0.0.1:5432;redis=127.0.0.1:6379
# PREFLIGHT_REQUIRED_HTTP=api=http://127.0.0.1:3000/health;memory=http://127.0.0.1:7331/health
# PREFLIGHT_REQUIRED_PROCESSES=base-code-memory=base.?code.?memory
PREFLIGHT_REQUIRED_DIRECTORIES=
PREFLIGHT_REQUIRED_WRITABLE_DIRECTORIES=
PREFLIGHT_REQUIRED_FILES=
PREFLIGHT_REQUIRED_TCP=
PREFLIGHT_REQUIRED_HTTP=
PREFLIGHT_REQUIRED_PROCESSES=

# Exact Prompt Builder version expected by the consumer.
PREFLIGHT_PROMPT_BUILDER_VERSION={{PROMPT_BUILDER_VERSION}}
# Optional local built CLI, relative to project root. The Python runner exports it as
# VIGILIO_PROMPT_BUILDER_CLI so preflight and execution use the same binary.
PREFLIGHT_PROMPT_BUILDER_CLI=
