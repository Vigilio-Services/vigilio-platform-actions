{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigilio.dev/schemas/prompt-plan.v1.schema.json",
  "title": "Vigilio Prompt Plan v1",
  "type": "object",
  "required": ["schema_version", "id", "packs", "dependency_policy"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dependency_policy": {
      "enum": ["include-transitive", "require-explicit"]
    }
  },
  "additionalProperties": false
}
