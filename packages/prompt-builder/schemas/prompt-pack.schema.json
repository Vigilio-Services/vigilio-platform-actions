{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "version", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 3, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["active", "deprecated"] },
    "kind": { "enum": ["global", "module", "use-case", "workflow", "contract", "infra"] },
    "module": { "type": "string", "minLength": 1 },
    "use_case": { "type": "string", "minLength": 1 },
    "target_profile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "inherits": { "$ref": "#/$defs/stringList" },
    "depends_on": { "$ref": "#/$defs/stringList" },
    "execution": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "order": { "type": "integer", "minimum": 0 },
        "phases": {
          "type": "array",
          "items": { "$ref": "#/$defs/phase" },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "documents": {
      "oneOf": [
        { "$ref": "#/$defs/stringList" },
        {
          "type": "object",
          "properties": {
            "required": { "$ref": "#/$defs/stringList" },
            "optional": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        }
      ]
    },
    "openspec": {
      "type": "object",
      "properties": {
        "capability": { "type": "string" },
        "capabilities": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": false
    },
    "skills": {
      "oneOf": [
        { "$ref": "#/$defs/stringList" },
        {
          "type": "object",
          "properties": {
            "primary": { "$ref": "#/$defs/stringList" },
            "supporting": { "$ref": "#/$defs/stringList" },
            "conditional": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/conditionalSkill" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "allowed_code_paths": { "$ref": "#/$defs/stringList" },
    "forbidden_code_paths": { "$ref": "#/$defs/stringList" },
    "scope": { "$ref": "#/$defs/scope" },
    "federated_scope": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scope" } },
    "quality_gates": {
      "oneOf": [
        { "$ref": "#/$defs/stringList" },
        {
          "type": "object",
          "properties": {
            "required": { "$ref": "#/$defs/stringList" },
            "conditional": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "when_document_exists": { "type": "string" },
                  "when_change_touches": { "$ref": "#/$defs/stringList" },
                  "gates": { "$ref": "#/$defs/stringList" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$defs": {
    "phase": { "enum": ["explore", "propose", "apply", "review", "fix"] },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "properties": {
        "allowed_paths": { "$ref": "#/$defs/stringList" },
        "forbidden_paths": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": false
    },
    "conditionalSkill": {
      "type": "object",
      "properties": {
        "when_document_exists": { "type": "string" },
        "when_change_touches": { "$ref": "#/$defs/stringList" },
        "use": { "$ref": "#/$defs/stringList" }
      },
      "required": ["use"],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
